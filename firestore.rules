rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for Saved Video document
    function isValidSavedVideo(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.videoId is string && data.videoId.size() > 0 && data.videoId.size() <= 64 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
             data.author is string && data.author.size() <= 200 &&
             (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000)) &&
             data.summaryPersian is string && data.summaryPersian.size() <= 10000 &&
             (!('subtitlesJson' in data) || (data.subtitlesJson is string && data.subtitlesJson.size() <= 2000000));
    }

    // Validation for Saved Word document
    function isValidSavedWord(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.word is string && data.word.size() > 0 && data.word.size() <= 200 &&
             (!('phonetic' in data) || (data.phonetic is string && data.phonetic.size() <= 200)) &&
             data.persianMeaning is string && data.persianMeaning.size() > 0 && data.persianMeaning.size() <= 1000 &&
             (!('partOfSpeech' in data) || (data.partOfSpeech is string && data.partOfSpeech.size() <= 50)) &&
             (!('englishSentence' in data) || (data.englishSentence is string && data.englishSentence.size() <= 2000)) &&
             (!('sourceVideoTitle' in data) || (data.sourceVideoTitle is string && data.sourceVideoTitle.size() <= 500));
    }

    // Scoped user space
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId);

      // Saved Videos subcollection
      match /saved_videos/{videoId} {
        allow get: if isOwner(userId) && isValidId(videoId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(videoId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidSavedVideo(incoming()) &&
                         incoming().keys().hasAll(['userId', 'videoId', 'title', 'author', 'summaryPersian', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'videoId', 'title', 'author', 'thumbnailUrl', 'summaryPersian', 'subtitlesJson', 'createdAt', 'updatedAt']);

        allow update: if isOwner(userId) &&
                         isValidId(videoId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidSavedVideo(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'author', 'thumbnailUrl', 'summaryPersian', 'subtitlesJson', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(videoId);
      }

      // Saved Words subcollection
      match /saved_words/{wordId} {
        allow get: if isOwner(userId) && isValidId(wordId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(wordId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         isValidSavedWord(incoming()) &&
                         incoming().keys().hasAll(['userId', 'word', 'persianMeaning', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'word', 'phonetic', 'persianMeaning', 'partOfSpeech', 'englishSentence', 'sourceVideoTitle', 'createdAt', 'updatedAt']);

        allow update: if isOwner(userId) &&
                         isValidId(wordId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidSavedWord(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['word', 'phonetic', 'persianMeaning', 'partOfSpeech', 'englishSentence', 'sourceVideoTitle', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(wordId);
      }
    }
  }
}
